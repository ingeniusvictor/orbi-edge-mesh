{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://orbi.local/schemas/trust-store.schema.json",
  "title": "ORBI Edge Trust Store",
  "type": "object",
  "required": [
    "version",
    "nodes"
  ],
  "properties": {
    "version": {
      "type": "string",
      "const": "0.1"
    },
    "nodes": {
      "type": "object",
      "additionalProperties": {
        "type": "object",
        "required": [
          "fingerprint",
          "secret",
          "trusted"
        ],
        "properties": {
          "fingerprint": {
            "type": "string",
            "minLength": 1
          },
          "secret": {
            "type": "string",
            "minLength": 1
          },
          "trusted": {
            "type": "boolean"
          }
        },
        "additionalProperties": false
      }
    }
  },
  "additionalProperties": false
}
